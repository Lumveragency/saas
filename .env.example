# ---------------------------------------------------------------------------
# MarketScan environment variables
# Copy to .env.local (Next.js loads it automatically) and fill in values.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# SQLite (default, zero-config for local dev):
DATABASE_URL="file:./prisma/dev.db"
# For production use Postgres instead, e.g.:
# DATABASE_URL="postgresql://user:pass@host:5432/marketscan?schema=public"

# --- Auth -----------------------------------------------------------------
# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Research engine (REQUIRED for real forecasts) ------------------------
# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# The research engine uses Claude with its built-in web_search tool, so no
# separate search-provider key is required.
ANTHROPIC_API_KEY=""
# Optional model overrides:
FORECAST_MODEL="claude-sonnet-5"
PARSER_MODEL="claude-haiku-4-5-20251001"
# Max web searches per analysis (cost control):
MAX_WEB_SEARCHES="6"

# --- Stripe (REQUIRED for real billing) -----------------------------------
# Server-side secret key: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
# Webhook signing secret from `stripe listen` or the dashboard endpoint:
STRIPE_WEBHOOK_SECRET=""
# Price IDs created in the Stripe dashboard (recurring prices).
# PRO price must be configured with a $1 / 7-day trial via the trial settings
# in code (trial_period_days) — see README.
STRIPE_PRICE_PRO=""      # $27 / month
STRIPE_PRICE_SCALE=""    # $79 / month (future tier)

# --- App ------------------------------------------------------------------
# Public base URL, used for Stripe redirect URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Monthly analysis allowance for the Pro plan (cost control).
PRO_MONTHLY_LIMIT="100"
SCALE_MONTHLY_LIMIT="500"
